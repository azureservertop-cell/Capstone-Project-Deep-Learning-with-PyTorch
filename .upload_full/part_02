 Recall\n","- F1-score"]},{"cell_type":"code","execution_count":15,"id":"19ec027d","metadata":{},"outputs":[{"name":"stdout","output_type":"stream","text":["Custom CNN\n","Accuracy:  0.8560\n","Precision: 0.8589\n","Recall:    0.8560\n","F1-score:  0.8549\n"]}],"source":["def get_predictions(model, data_loader):\n","    model.eval()\n","\n","    all_labels = []\n","    all_predictions = []\n","\n","    with torch.no_grad():\n","        for data, target in data_loader:\n","            data = data.to(device)\n","\n","            output = model(data)\n","            predicted = output.argmax(dim=1).cpu()\n","\n","            all_labels.extend(target.numpy())\n","            all_predictions.extend(predicted.numpy())\n","\n","    return np.array(all_labels), np.array(all_predictions)\n","\n","\n","y_true, y_pred = get_predictions(\n","    final_cnn,\n","    test_loader\n",")\n","\n","cnn_accuracy = accuracy_score(y_true, y_pred)\n","\n","cnn_precision = precision_score(\n","    y_true,\n","    y_pred,\n","    average=\"weighted\",\n","    zero_division=0\n",")\n","\n","cnn_recall = recall_score(\n","    y_true,\n","    y_pred,\n","    average=\"weighted\",\n","    zero_division=0\n",")\n","\n","cnn_f1 = f1_score(\n","    y_true,\n","    y_pred,\n","    average=\"weighted\",\n","    zero_division=0\n",")\n","\n","print(\"Custom CNN\")\n","print(f\"Accuracy:  {cnn_accuracy:.4f}\")\n","print(f\"Precision: {cnn_precision:.4f}\")\n","print(f\"Recall:    {cnn_recall:.4f}\")\n","print(f\"F1-score:  {cnn_f1:.4f}\")"]},{"cell_type":"markdown","id":"f3d33a6b","metadata":{},"source":["## 12. Confusion Matrix\n","\n","The confusion matrix helps identify which classes are commonly confused."]},{"cell_type":"code","execution_count":16,"id":"8a7df83f","metadata":{},"outputs":[{"data":{"text/plain":["<Figure size 1000x1000 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, ax = plt.subplots(figsize=(10, 10))\n","\n","ConfusionMatrixDisplay.from_predictions(\n","    y_true,\n","    y_pred,\n","    display_labels=class_names,\n","    xticks_rotation=45,\n","    ax=ax\n",")\n","\n","plt.title(\"Custom CNN Confusion Matrix\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"e85b45d3","metadata":{},"source":["## 13. Correct and Incorrect Prediction Examples"]},{"cell_type":"code","execution_count":17,"id":"ed4c8b3b","metadata":{},"outputs":[],"source":["def show_examples(model, data_loader, show_wrong=True, max_images=8):\n","    model.eval()\n","\n","    examples = []\n","\n","    with torch.no_grad():\n","        for data, target in data_loader:\n","            output = model(data.to(device))\n","            predicted = output.argmax(dim=1).cpu()\n","\n","            for image, true_label, pred_label in zip(data, target, predicted):\n","                wrong = true_label.item() != pred_label.item()\n","\n","                if wrong == show_wrong:\n","                    examples.append(\n","                        (image, true_label.item(), pred_label.item())\n","                    )\n","\n","                if len(examples) >= max_images:\n","                    break\n","\n","            if len(examples) >= max_images:\n","                break\n","\n","    plt.figure(figsize=(12, 6))\n","\n","    for i, (image, true_label, pred_label) in enumerate(examples):\n","        plt.subplot(2, 4, i + 1)\n","\n","        image = denormalize(image).permute(1, 2, 0)\n","\n","        plt.imshow(image)\n","        plt.title(\n","            f\"True: {class_names[true_label]}\\n\"\n","            f\"Pred: {class_names[pred_label]}\"\n","        )\n","        plt.axis(\"off\")\n","\n","    plt.tight_layout()\n","    plt.show()"]},{"cell_type":"code","execution_count":18,"id":"7d6286ea","metadata":{},"outputs":[{"name":"stdout","output_type":"stream","text":["Correct predictions\n"]},{"data":{"text/plain":["<Figure size 1200x600 with 8 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_typ